PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/regive
# BẮT BUỘC: đổi thành chuỗi dài ngẫu nhiên trước khi chạy ngoài local (npm sẽ cảnh báo nếu để mặc định)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
NODE_ENV=development
AI_PROVIDER=gemini
AI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AUTH_RATE_LIMIT_MAX=50
API_RATE_LIMIT_MAX=300
VN_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VN_PAY_MERCHANT_ID=
VN_PAY_HASH_SECRET=
VN_PAY_HASH_KEY=
# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ReGive <noreply@regive.vn>

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

FRONTEND_URL=http://localhost:3000
